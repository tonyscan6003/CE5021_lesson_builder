<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ lesson_number }} {{ meta.title }} · {{ course.title }}</title>
<link rel="stylesheet" href="style.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>
{% if uses_plotly %}<script src="https://cdn.plot.ly/plotly-2.35.2.min.js" charset="utf-8"></script>{% endif %}
<script defer src="site.js"></script>
</head>
<body>
<header class="topbar">
  <a class="brand" href="index.html">{{ course.title }}</a>
  <span class="crumb">Section {{ section.number }}: {{ section.title }}</span>
</header>

<div class="layout">
<aside class="sidebar">
  <nav class="toc">
    <p class="toc-title">On this page</p>
    <ul>
    {% for hid, text in toc %}<li><a href="#{{ hid }}">{{ text }}</a></li>{% endfor %}
    </ul>
  </nav>
  <nav class="section-nav">
    <p class="toc-title">Section {{ section.number }}</p>
    <ul>
    {% for les in section.lessons %}
      <li{% if les.id == meta.id %} class="current"{% elif les.id not in built %} class="pending"{% endif %}>
        {% if les.id == meta.id %}<span>{{ les.id[3:] | int }}. {{ les.title }}</span>
        {% elif les.id not in built %}<span title="not published yet">{{ les.id[3:] | int }}. {{ les.title }}</span>
        {% else %}<a href="{{ les.id }}.html">{{ les.id[3:] | int }}. {{ les.title }}</a>{% endif %}
      </li>
    {% endfor %}
    </ul>
  </nav>
</aside>

<main class="lesson">
  <p class="kicker">Lesson {{ lesson_number }}</p>
  <h1>{{ meta.title }}</h1>
  {% if meta.summary %}<p class="summary">{{ meta.summary }}</p>{% endif %}

  {{ body }}

  {% if practice %}
  <section class="practice">
    <h2 id="practice">Practice questions</h2>
    <p>Question types from the CE6021 question bank that cover this lesson:
    {% for p in practice %}<code>{{ p }}</code>{% if not loop.last %}, {% endif %}{% endfor %}.</p>
  </section>
  {% endif %}

  {% if image_credits %}
  <section class="credits">
    <h2 id="image-credits">Image credits</h2>
    <ul>{% for c in image_credits %}<li>{{ c }}</li>{% endfor %}</ul>
    <p>Other figures are generated from synthetic data by the lesson engines.</p>
  </section>
  {% endif %}

  <nav class="pager">
    {% if prev %}<a class="prev" href="{{ prev.file }}">&larr; {{ prev.id | replace('_', '.') }} {{ prev.title }}</a>{% else %}<span></span>{% endif %}
    {% if next %}<a class="next" href="{{ next.file }}">{{ next.id | replace('_', '.') }} {{ next.title }} &rarr;</a>{% endif %}
  </nav>
  <footer class="foot">© Dr Tony Scanlan, University of Limerick. Figures generated by the CE6021 lesson builder.</footer>
</main>
</div>
</body>
</html>
